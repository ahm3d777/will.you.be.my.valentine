{
  "name": "will-you-be-my-valentine",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -b && tsc -p worker && vite build",
